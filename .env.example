# 复制这个文件成 .env，填上你自己的模型信息。
# .env 已经在 .gitignore 里，填了不会被提交。
#
# 项目不预设任何服务商 —— 只要接口是 OpenAI 兼容的就能接。
# ⚠️ base_url 一般要带路径（比如结尾的 /v1），具体看服务商的文档。

# ── 主模型（必填）────────────────────────────
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# ── 备用模型（可选，留空就是不用）────────────
# 主模型调用失败时会自动切过去。建议选另一家厂商，免得一起挂。
# ⚠️ 备用模型得扛得住长上下文：本项目单次请求轻松上万 token，
#    实测有些小模型 180 秒都出不来，那种等于没有备用。
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
